rules_version = '2';

// Paste this into Firebase Console > Firestore Database > Rules, then Publish.
// Replace YOUR_WEDDING_CODE with the exact same value you put in firebase-config.js
// (window.WEDDING_CODE) -- both spots below.
//
// Data model:
//   weddingDrinkSettings/config    - one doc: event title + display options
//   weddingDrinkMenu/{itemId}      - curated bar menu (name, volumeMl, category, active)
//   weddingDrinkGuests/{guestId}   - one doc per guest, keyed by a slug of their name,
//                                    holding running totals (totalMl, drinkCount)
//   weddingDrinkLog/{logId}        - one doc per drink logged, auto-id
//
// What this allows, by design (no backend = no real auth -- guests just type
// their name, which keeps it frictionless for a party):
//   - Anyone with the app link can read the menu, guest list, leaderboard, and log.
//   - Editing the MENU or SETTINGS (the admin actions) requires the wedding code.
//   - Logging a drink, creating your own guest profile, and undoing your own drink
//     do NOT require the code -- any guest with the link can do these freely.
//   - Hard deletes are blocked entirely. "Undo" a drink by marking its log entry
//     voided (an update, not a delete) and reversing the guest's totals in the
//     same batch, rather than actually deleting anything.
service cloud.firestore {
  match /databases/{database}/documents {

    match /weddingDrinkSettings/{docId} {
      allow read: if true;
      allow create, update: if request.resource.data.code == "YOUR_WEDDING_CODE";
      allow delete: if false;
    }

    match /weddingDrinkMenu/{itemId} {
      allow read: if true;
      allow create, update: if request.resource.data.code == "YOUR_WEDDING_CODE"
                   && request.resource.data.name is string
                   && request.resource.data.name.size() > 0
                   && request.resource.data.volumeMl is number
                   && request.resource.data.volumeMl > 0;
      allow delete: if false;
    }

    match /weddingDrinkGuests/{guestId} {
      allow read: if true;
      allow create, update: if request.resource.data.name is string
                   && request.resource.data.name.size() > 0
                   && request.resource.data.totalMl is number
                   && request.resource.data.totalMl >= 0
                   && request.resource.data.drinkCount is number
                   && request.resource.data.drinkCount >= 0;
      allow delete: if false;
    }

    match /weddingDrinkLog/{logId} {
      allow read: if true;
      allow create: if request.resource.data.guestId is string
                   && request.resource.data.guestId.size() > 0
                   && request.resource.data.itemName is string
                   && request.resource.data.volumeMl is number
                   && request.resource.data.volumeMl > 0
                   && request.resource.data.voided == false;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(["voided"]);
      allow delete: if false;
    }
  }
}
