rules_version = '2';

// Paste this into Firebase Console > Firestore Database > Rules, then Publish.
// The passcode below ("cheers2026") matches window.WEDDING_CODE in
// firebase-config.js. If you change one, change the other (both spots below).
//
// Data model:
//   weddingDrinkSettings/config    - one doc: event title + display options
//   weddingDrinkMenu/{itemId}      - curated bar menu (name, volumeMl, category, active)
//   weddingDrinkGuests/{guestId}   - one doc per guest, keyed by a slug of their name,
//                                    holding running totals (totalMl, drinkCount) and
//                                    an "archived" flag set by admin remove/purge
//   weddingDrinkLog/{logId}        - one doc per drink logged, auto-id
//   weddingDrinkPhotos/{photoId}   - guest-uploaded photo: small thumbnail (data URL),
//                                    uploader, and a "hidden" flag admin can set
//   weddingDrinkPhotoFull/{photoId}- the larger copy of the same photo, loaded on tap
//
// What this allows, by design (no backend = no real auth -- guests just type
// their name, which keeps it frictionless for a party):
//   - Anyone with the app link can read the menu, guest list, leaderboard, and log.
//   - Editing the MENU or SETTINGS (the admin actions) requires the wedding code.
//   - Logging a drink, creating your own guest profile, and undoing your own drink
//     do NOT require the code -- any guest with the link can do these freely.
//   - Archiving a guest (the admin "Remove"/"Purge all" action) DOES require the
//     code -- everything else about a guest doc can be self-updated, but setting
//     archived == true cannot.
//   - Anyone with the link can upload photos; hiding one from the gallery (admin
//     only) requires the code. Photos are size-capped so a single upload can't
//     bloat the database.
//   - Photos can be hard-deleted only after being hidden (hiding needs the code).
//   - Optional drink notes are capped at 140 chars; hiding one is admin-only.
//   - "Purge all guests & drinks" really deletes: it first marks every guest archived and
//     every drink purged (both need the passcode), then deletes them. A guest doc can only
//     be deleted once archived, and a drink only once purged, so a delete can't be used
//     without the passcode. Every other hard delete is blocked entirely.
//   - "Undo" a drink and admin "Remove" (one guest) just mark things (voided / archived)
//     rather than deleting them -- a removed guest reappears automatically (unarchived)
//     if they log a new drink.
service cloud.firestore {
  match /databases/{database}/documents {

    match /weddingDrinkSettings/{docId} {
      allow read: if true;
      allow create, update: if request.resource.data.code == "cheers2026";
      allow delete: if false;
    }

    match /weddingDrinkMenu/{itemId} {
      allow read: if true;
      allow create, update: if request.resource.data.code == "cheers2026"
                   && request.resource.data.name is string
                   && request.resource.data.name.size() > 0
                   && request.resource.data.volumeMl is number
                   && request.resource.data.volumeMl > 0;
      allow delete: if false;
    }

    match /weddingDrinkGuests/{guestId} {
      allow read: if true;
      allow create, update: if request.resource.data.name is string
                   && request.resource.data.name.size() > 0
                   && request.resource.data.totalMl is number
                   && request.resource.data.totalMl >= 0
                   && request.resource.data.drinkCount is number
                   && request.resource.data.drinkCount >= 0
                   && (request.resource.data.get('archived', false) != true
                       || request.resource.data.code == "cheers2026");
      // Delete requests carry no data, so the passcode can't be checked here.
      // Instead a guest can only be deleted once archived, and archiving
      // requires the passcode (see the rule above).
      allow delete: if resource.data.get('archived', false) == true;
    }

    match /weddingDrinkPhotos/{photoId} {
      allow read: if true;
      allow create: if request.resource.data.guestId is string
                   && request.resource.data.guestId.size() > 0
                   && request.resource.data.thumb is string
                   && request.resource.data.thumb.size() < 120000
                   && request.resource.data.hidden == false;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(["hidden", "code"])
                   && request.resource.data.code == "cheers2026";
      // Delete requests carry no data, so the passcode can't be checked here.
      // Instead a photo can only be deleted once it's already hidden, and
      // hiding requires the passcode (see the update rule above).
      allow delete: if resource.data.hidden == true;
    }

    match /weddingDrinkPhotoFull/{photoId} {
      allow read: if true;
      allow create: if request.resource.data.full is string
                   && request.resource.data.full.size() < 900000;
      allow update: if false;
      allow delete: if get(/databases/$(database)/documents/weddingDrinkPhotos/$(photoId)).data.hidden == true;
    }

    match /weddingDrinkLog/{logId} {
      allow read: if true;
      allow create: if request.resource.data.guestId is string
                   && request.resource.data.guestId.size() > 0
                   && request.resource.data.itemName is string
                   && request.resource.data.volumeMl is number
                   && request.resource.data.volumeMl > 0
                   && request.resource.data.voided == false
                   && request.resource.data.get('message', '') is string
                   && request.resource.data.get('message', '').size() <= 140;
      // Anyone can void a drink (undo); hiding a note from the feed is admin-only.
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(["voided"])
                   || (request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(["messageHidden", "code"])
                       && request.resource.data.code == "cheers2026")
                   // Purge all: mark a drink purged (passcode needed) before it can be deleted.
                   || (request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(["voided", "purged", "code"])
                       && request.resource.data.code == "cheers2026");
      allow delete: if resource.data.get('purged', false) == true;
    }
  }
}
